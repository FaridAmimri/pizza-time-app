# Copier ce fichier en .env.local puis renseigner les valeurs. Ne JAMAIS mettre une vraie clé dans ce fichier : il est publié sur GitHub.
ANTHROPIC_API_KEY=sk-ant-REMPLACER-PAR-VOTRE-CLE
# Optionnel : changer de modèle sans toucher au code
# ANTHROPIC_MODEL=claude-sonnet-5-5

# En ligne (Vercel) uniquement : adresse de la base Neon. En local, laisser vide : les fiches vont dans le dossier data/.
# DATABASE_URL=postgresql://utilisateur:motdepasse@hote.neon.tech/neondb?sslmode=require
# Code d'accès au site. Obligatoire sur Vercel ; en local, laisser vide pour ne pas avoir à le saisir.
# ACCES_MOT_DE_PASSE=choisir-un-code-long
